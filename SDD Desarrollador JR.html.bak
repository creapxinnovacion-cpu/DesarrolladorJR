<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>SDD Desarrollador JR</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
/* Concepto: plano técnico. Un documento SDD numerado con una ventana de parallax tipo plano en la portada. */
:root{
  --paper:#F2F5F9; --surface:#FFFFFF; --surface-2:#E8EDF4;
  --ink:#0D1B2E; --ink-2:#4A5B72; --line:#CBD5E3;
  --accent:#0A55FF; --accent-ink:#FFFFFF; --accent-soft:#DCE6FF;
  --amber:#F2A900; --amber-ink:#2A1C00;
  --ok:#0E7A55;
  --grid:rgba(10,85,255,.10);
  --mark-bg:#0A4FE6; --mark-fg:#FFFFFF; --mark-px:#FFC53D;
  --f-display:"Bricolage Grotesque","Segoe UI",system-ui,sans-serif;
  --f-body:"IBM Plex Sans","Segoe UI",system-ui,sans-serif;
  --f-mono:"JetBrains Mono",ui-monospace,Consolas,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#0A1424; --surface:#101D33; --surface-2:#16253F;
    --ink:#E7EDF7; --ink-2:#9FB0C9; --line:#243553;
    --accent:#6B97FF; --accent-ink:#06101F; --accent-soft:#16294F;
    --amber:#F5B93A; --amber-ink:#2A1C00;
    --ok:#4CC38A;
    --grid:rgba(107,151,255,.13);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --paper:#0A1424; --surface:#101D33; --surface-2:#16253F;
  --ink:#E7EDF7; --ink-2:#9FB0C9; --line:#243553;
  --accent:#6B97FF; --accent-ink:#06101F; --accent-soft:#16294F;
  --amber:#F5B93A; --amber-ink:#2A1C00;
  --ok:#4CC38A;
  --grid:rgba(107,151,255,.13);
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--paper);color:var(--ink);font:400 16px/1.6 var(--f-body);-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--paper)}
a{color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:3px}
h1,h2,h3{font-family:var(--f-display);margin:0;text-wrap:balance;letter-spacing:-.01em}
p{margin:0}
ul,ol{margin:0;padding:0;list-style:none}
.wrap{max-width:1180px;margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.mono{font-family:var(--f-mono)}
.label{font:500 11px/1.3 var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-2)}
svg.ic,.ic svg{width:1.15em;height:1.15em;stroke-width:1.75}

/* Barra superior */
.topbar{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--paper);border-bottom:1px solid var(--line)}
.topbar .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:10px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink);min-width:0}
.brand .mark{width:38px;height:38px;flex:none}
.brand b{display:block;font:700 18px/1.1 var(--f-display);font-stretch:90%}
.brand small{display:block;font:500 10px/1.3 var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-2)}
.navlinks{display:none;gap:4px}
.navlinks a{padding:8px 12px;border-radius:4px;color:var(--ink-2);text-decoration:none;font-size:14px;font-weight:500}
.navlinks a:hover{color:var(--ink);background:var(--surface-2)}
@media (min-width:960px){.navlinks{display:flex}}
.iconbtn{display:inline-grid;place-items:center;width:40px;height:40px;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:6px;cursor:pointer}
.iconbtn:hover{border-color:var(--accent)}
.iconbtn svg{width:18px;height:18px}
.ico-sun{display:none}
:root[data-theme="dark"] .ico-sun{display:block}
:root[data-theme="dark"] .ico-moon{display:none}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]) .ico-sun{display:block}
  :root:not([data-theme="light"]) .ico-moon{display:none}
}

/* Portada */
.hero{display:grid;grid-template-columns:1fr;gap:32px;padding-block:40px 48px;align-items:center}
@media (min-width:900px){.hero{grid-template-columns:1.1fr .9fr;gap:48px;padding-block:64px 72px}}
.hero > *{min-width:0}
.docid{display:inline-flex;flex-wrap:wrap;gap:8px 14px;font:500 12px/1.4 var(--f-mono);color:var(--ink-2);letter-spacing:.06em}
.docid span:first-child{color:var(--accent)}
.hero h1{font-size:clamp(44px,8vw,92px);line-height:.98;font-weight:750;font-stretch:84%;margin-block:18px 18px}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero .lede{font-size:18px;max-width:52ch;color:var(--ink-2)}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:12px 18px;border-radius:6px;font:600 15px/1 var(--f-body);text-decoration:none;border:1px solid var(--line);color:var(--ink);background:var(--surface);cursor:pointer}
.btn:hover{border-color:var(--accent)}
.btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn.primary:hover{filter:brightness(1.08)}
.btn svg{width:18px;height:18px}
.facts{display:flex;flex-wrap:wrap;gap:12px 36px;margin-top:36px;padding-top:20px;border-top:1px solid var(--line)}
.facts div{min-width:110px}
.facts b{display:block;font:700 34px/1 var(--f-display);font-stretch:85%;font-variant-numeric:tabular-nums}
.facts span{font-size:13px;color:var(--ink-2)}

/* Ventana parallax */
.stage{position:relative;width:100%;max-width:480px;margin-inline:auto;aspect-ratio:1/1;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--surface)}
.pl{position:absolute;transition:transform .22s ease-out;will-change:transform}
.pl.fill{inset:0}
.pl.grid{inset:-14%;background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:32px 32px}
.pl.fine{inset:-14%;background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:8px 8px;opacity:.5}
.blueprint{width:100%;height:100%;display:block}
.blueprint .ln{stroke:var(--accent);fill:none;stroke-width:1;opacity:.55}
.blueprint .ln.s{opacity:.9}
.blueprint .dash{stroke-dasharray:3 6}
.blueprint text{font:500 10px var(--f-mono);fill:var(--ink-2);letter-spacing:.08em}
#ring{transform-box:fill-box;transform-origin:center}
.centermark{display:grid;place-items:center}
.bigmark{width:36%;aspect-ratio:1;display:block;filter:drop-shadow(0 10px 24px rgba(10,79,230,.28))}
.tagchip{display:inline-block;padding:6px 10px;border:1px solid var(--line);background:var(--surface);border-radius:4px;font:500 12px/1 var(--f-mono);color:var(--ink);white-space:nowrap}
.tagchip.hot{background:var(--amber);color:var(--amber-ink);border-color:var(--amber)}
.stage .pl.chipbox{pointer-events:none}

/* Documento */
.doc{display:grid;grid-template-columns:minmax(0,1fr);gap:24px;padding-bottom:72px}
@media (min-width:1080px){.doc{grid-template-columns:210px minmax(0,1fr);gap:56px}}
.toc{align-self:start;border:1px solid var(--line);background:var(--surface);border-radius:6px;padding:16px}
.toc ol{display:grid;grid-template-columns:1fr 1fr;gap:2px 12px;margin-top:10px}
.toc a{display:flex;gap:10px;padding:6px 8px;border-radius:4px;color:var(--ink-2);text-decoration:none;font-size:14px;font-weight:500}
.toc a i{font:500 12px/1.7 var(--f-mono);color:var(--ink-2);font-style:normal}
.toc a:hover{background:var(--surface-2);color:var(--ink)}
.toc a.on{background:var(--accent-soft);color:var(--ink)}
.toc a.on i{color:var(--accent)}
@media (min-width:1080px){
  .toc{position:sticky;top:calc(env(safe-area-inset-top,0px) + 84px);border:0;background:transparent;padding:0}
  .toc ol{grid-template-columns:1fr;gap:2px}
}
main{min-width:0}
.ctrl{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:6px;overflow:hidden}
.ctrl div{background:var(--surface);padding:12px 14px}
.ctrl dt{font:500 10px/1.3 var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-2)}
.ctrl dd{margin:4px 0 0;font-weight:500;font-size:15px}
.ctrl dd.ok{color:var(--ok)}
.sec{padding-block:56px 8px;scroll-margin-top:calc(env(safe-area-inset-top,0px) + 72px)}
.sec + .sec{border-top:1px solid var(--line);margin-top:48px}
.sec > h2{display:flex;align-items:baseline;gap:14px;font-size:clamp(30px,4.4vw,44px);line-height:1.05;font-weight:700;font-stretch:88%}
.sec > h2 i{font:500 15px/1 var(--f-mono);font-style:normal;color:var(--accent);letter-spacing:.04em}
.sec .intro{margin-top:14px;max-width:64ch;color:var(--ink-2)}
.sub{margin-top:36px}
.sub h3{display:flex;align-items:baseline;gap:10px;font-size:21px;font-weight:650;font-stretch:92%;margin-bottom:12px}
.sub h3 i{font:500 13px/1 var(--f-mono);font-style:normal;color:var(--accent)}
.sub p{max-width:68ch}
.sub p + p{margin-top:10px}
.two{display:grid;grid-template-columns:1fr;gap:20px}
.two > *{min-width:0}
@media (min-width:760px){.two{grid-template-columns:1fr 1fr;gap:28px}}
.defs{display:grid;gap:10px}
.defs div{display:grid;grid-template-columns:96px 1fr;gap:12px;padding-bottom:10px;border-bottom:1px solid var(--line)}
.defs dt{font:500 13px/1.5 var(--f-mono);color:var(--accent)}
.defs dd{margin:0;font-size:15px;color:var(--ink-2)}
.refs li{display:flex;gap:10px;align-items:baseline;padding:7px 0;border-bottom:1px solid var(--line);font-size:15px;color:var(--ink-2)}
.refs li span{font:500 12px/1 var(--f-mono);color:var(--accent);flex:none}

/* Tarjetas */
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:18px;min-width:0}
.card .ic{display:inline-grid;place-items:center;width:38px;height:38px;border-radius:6px;background:var(--accent-soft);color:var(--accent);margin-bottom:12px}
.card h4{margin:0 0 6px;font:650 17px/1.25 var(--f-display);font-stretch:92%}
.card p{font-size:14.5px;color:var(--ink-2)}
.card .tags{margin-top:12px}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tags li{padding:4px 8px;border:1px solid var(--line);border-radius:4px;font:500 11.5px/1.2 var(--f-mono);color:var(--ink-2);background:var(--paper)}
.principles{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0;border:1px solid var(--line);border-radius:6px;overflow:hidden;background:var(--surface)}
.principles li{padding:16px 18px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);margin:0 -1px -1px 0;font-size:14.5px;color:var(--ink-2)}
.principles b{display:block;color:var(--ink);font-weight:600;margin-bottom:4px}

/* Arquitectura */
.tiers{display:grid;gap:0}
.tier{display:grid;grid-template-columns:1fr;gap:10px;background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:14px 16px}
@media (min-width:760px){.tier{grid-template-columns:150px 1fr;align-items:center;gap:16px}}
.tier .label{display:flex;align-items:center;gap:8px;color:var(--accent)}
.tier .label svg{width:16px;height:16px}
.nodes{display:flex;flex-wrap:wrap;gap:8px}
.nodes li{padding:7px 11px;border:1px solid var(--line);border-radius:4px;background:var(--paper);font:500 13px/1.2 var(--f-mono)}
.nodes li.k{border-color:var(--accent);background:var(--accent-soft)}
.flow{height:30px;display:block;width:100%}
.flow line{stroke:var(--accent);stroke-width:1.5;stroke-dasharray:4 6;opacity:.8}
.flow polygon{fill:var(--accent)}
.steps{counter-reset:s;display:grid;grid-template-columns:1fr;gap:0;border:1px solid var(--line);border-radius:6px;background:var(--surface);overflow:hidden}
@media (min-width:900px){.steps{grid-template-columns:repeat(5,1fr)}}
.steps li{counter-increment:s;padding:16px;border-bottom:1px solid var(--line);font-size:14px;color:var(--ink-2);min-width:0}
@media (min-width:900px){.steps li{border-bottom:0;border-right:1px solid var(--line)}.steps li:last-child{border-right:0}}
.steps li:last-child{border-bottom:0}
.steps li::before{content:"0" counter(s);display:block;font:500 12px/1 var(--f-mono);color:var(--accent);margin-bottom:8px}
.steps b{display:block;color:var(--ink);font-weight:600;margin-bottom:4px;font-size:15px}
.note{margin-top:12px;font-size:14px;color:var(--ink-2);display:flex;gap:8px;align-items:flex-start}
.note svg{width:16px;height:16px;flex:none;margin-top:3px;color:var(--amber)}

/* Módulos */
.filters{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}
.fchip{padding:8px 14px;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:999px;font:500 13px/1 var(--f-body);cursor:pointer}
.fchip:hover{border-color:var(--accent)}
.fchip[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.count{margin-top:12px;font:500 12px/1 var(--f-mono);color:var(--ink-2)}
.mods{display:grid;grid-template-columns:1fr;gap:16px;margin-top:16px}
@media (min-width:900px){.mods{grid-template-columns:1fr 1fr}}
.mod{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:20px;display:flex;flex-direction:column;gap:14px;min-width:0}
.mod[hidden]{display:none}
.mod header{display:flex;align-items:center;justify-content:space-between;gap:10px}
.mid{font:500 12px/1 var(--f-mono);color:var(--accent);letter-spacing:.06em}
.badges{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end}
.badge{padding:3px 8px;border-radius:999px;background:var(--surface-2);font:500 11px/1.3 var(--f-mono);color:var(--ink-2)}
.mt{display:flex;gap:12px;align-items:center}
.mt .ic{display:inline-grid;place-items:center;flex:none;width:40px;height:40px;border-radius:6px;background:var(--accent-soft);color:var(--accent)}
.mt h3{font-size:22px;line-height:1.1;font-weight:700;font-stretch:90%}
.mod dl{margin:0;display:grid;gap:10px}
.mod dt{font:500 10.5px/1.3 var(--f-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-2)}
.mod dd{margin:3px 0 0;font-size:14.5px}
.mod dd ul{display:grid;gap:6px}
.mod dd li{display:flex;gap:8px;color:var(--ink-2)}
.mod dd li::before{content:"";flex:none;width:6px;height:6px;margin-top:8px;background:var(--accent)}
.mod .tags{margin-top:auto}

/* Datos */
.layers{border:1px solid var(--line);border-radius:6px;background:var(--surface);overflow:hidden}
.layers > div{display:grid;grid-template-columns:1fr;gap:8px;padding:14px 16px;border-bottom:1px solid var(--line)}
.layers > div:last-child{border-bottom:0}
@media (min-width:760px){.layers > div{grid-template-columns:170px 1fr;gap:16px;align-items:start}}
.layers .label{padding-top:5px}
.entities{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}
.entities .card h4{display:flex;justify-content:space-between;gap:8px;align-items:baseline}
.entities .card h4 small{font:500 11px/1 var(--f-mono);color:var(--ink-2)}
.ent{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.ent li{padding:4px 8px;border-radius:3px;background:var(--surface-2);font:500 11.5px/1.3 var(--f-mono);color:var(--ink)}

/* Calidad */
.qa{border:1px solid var(--line);border-radius:6px;background:var(--surface);overflow:hidden}
.qrow{display:grid;grid-template-columns:1fr;gap:6px;padding:16px;border-bottom:1px solid var(--line)}
.qrow:last-child{border-bottom:0}
@media (min-width:860px){.qrow{grid-template-columns:170px 1fr 190px;gap:24px;align-items:start}}
.qrow > *{min-width:0}
.qrow h4{margin:0;display:flex;gap:8px;align-items:center;font:650 16px/1.2 var(--f-display);font-stretch:92%}
.qrow h4 svg{width:18px;height:18px;color:var(--accent)}
.qrow p{font-size:14.5px;color:var(--ink-2)}
.qrow .ev{display:flex;flex-wrap:wrap;gap:6px}
.qrow .ev span{padding:3px 8px;border-radius:3px;background:var(--accent-soft);font:500 11.5px/1.3 var(--f-mono);color:var(--ink)}

/* Crecimiento y contacto */
.road{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.status{display:inline-block;margin-bottom:10px;padding:3px 8px;border-radius:3px;background:var(--amber);color:var(--amber-ink);font:500 11px/1.3 var(--f-mono);letter-spacing:.08em;text-transform:uppercase}
.contact{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-top:24px}
.contact .card{display:flex;flex-direction:column;gap:10px}
.contact .val{font:500 18px/1.3 var(--f-mono);overflow-wrap:anywhere;user-select:all}
.contact .row{display:flex;flex-wrap:wrap;gap:8px}
footer.foot{border-top:1px solid var(--line);background:var(--surface)}
footer.foot .wrap{display:flex;flex-wrap:wrap;gap:12px 24px;justify-content:space-between;align-items:center;padding-block:24px;font-size:13px;color:var(--ink-2)}
footer.foot .brand{color:var(--ink)}
.rv{will-change:transform}
</style>

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <symbol id="jr-mark" viewBox="0 0 64 64">
    <rect x="2" y="2" width="60" height="60" rx="15" style="fill:var(--mark-bg)"/>
    <path d="M24 17V38Q24 47 15 47" fill="none" stroke-width="6" stroke-linecap="square" style="stroke:var(--mark-fg)"/>
    <path d="M36 47V17H45Q52 17 52 24.5Q52 32 45 32H36" fill="none" stroke-width="6" stroke-linecap="square" stroke-linejoin="miter" style="stroke:var(--mark-fg)"/>
    <path d="M44 33L51 47" fill="none" stroke-width="6" stroke-linecap="square" style="stroke:var(--mark-px)"/>
  </symbol>
</svg>

<header class="topbar">
  <div class="wrap">
    <a class="brand" href="#inicio" aria-label="Desarrollador JR, inicio">
      <svg class="mark" viewBox="0 0 64 64" aria-hidden="true"><use href="#jr-mark"/></svg>
      <span><b>Desarrollador JR</b><small>Junior Developer · CreaPx</small></span>
    </a>
    <nav class="navlinks" aria-label="Secciones">
      <a href="#intro">Introducción</a>
      <a href="#arquitectura">Arquitectura</a>
      <a href="#modulos">Módulos</a>
      <a href="#calidad">Calidad</a>
      <a href="#contacto">Contacto</a>
    </nav>
    <button class="iconbtn" id="themeBtn" type="button" aria-label="Cambiar tema claro u oscuro">
      <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
    </button>
  </div>
</header>

<div class="wrap" id="inicio">
  <section class="hero" aria-labelledby="h1">
    <div>
      <p class="docid rise"><span>SDD-JR-001</span><span>versión 1.0</span><span>2 nov 2026</span></p>
      <h1 id="h1" class="rise">Desarrollador <em>JR</em></h1>
      <p class="lede rise">Documento de diseño de software de un Junior Developer en CreaPx. Describe qué construyo, cómo lo diseño y con qué lo sostengo, desde la facturación electrónica de El Salvador hasta apps móviles y de escritorio.</p>
      <div class="cta rise">
        <a class="btn primary" href="#modulos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>Ver los módulos</a>
        <a class="btn" href="#contacto">Contactar</a>
      </div>
      <div class="facts rise">
        <div><b data-count="10">10</b><span>módulos documentados</span></div>
        <div><b data-count="6">6</b><span>tipos de DTE emitidos</span></div>
        <div><b data-count="3">3</b><span>plataformas: web, móvil, escritorio</span></div>
      </div>
    </div>

    <div class="stage" id="stage" aria-hidden="true">
      <div class="pl grid" data-depth=".15"></div>
      <div class="pl fine" data-depth=".3"></div>
      <div class="pl fill" data-depth=".4">
        <svg class="blueprint" viewBox="0 0 400 400">
          <g id="ring">
            <circle class="ln dash" cx="200" cy="200" r="158"/>
            <path class="ln s" d="M200 34v12M200 354v12M34 200h12M354 200h12"/>
          </g>
          <circle class="ln" cx="200" cy="200" r="118"/>
