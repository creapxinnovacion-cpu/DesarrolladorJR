          <text x="200" y="352" text-anchor="middle">64 px</text>
          <text x="214" y="30">A · A</text>
          <text x="30" y="222">R 32</text>
        </svg>
      </div>
      <div class="pl fill centermark" data-depth=".75">
        <svg class="bigmark" viewBox="0 0 64 64"><use href="#jr-mark"/></svg>
