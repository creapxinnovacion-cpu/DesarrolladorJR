    {id:"MOD-03",icon:"stethoscope",name:"Sistema Médico",cats:["Web","Automatización"],
     prob:"Expedientes, citas y recetas llevados a mano producen dobles reservas y documentos con errores.",
     dis:["API REST en Node.js y Express con MVC modular. PostgreSQL en Neon y Google Sheets como libro de pacientes.","Regla en base de datos: un médico no tiene dos citas a la misma hora, y las citas vencidas pasan a PERDIDA.","Recetas en PDF estampadas sobre plantilla, con JWT, roles y límite de cambios de contraseña."],
     tags:["Node.js","Express","PostgreSQL","Neon","JWT","Apps Script","Bootstrap 5","SweetAlert2"]},
    {id:"MOD-04",icon:"package",name:"Control de Inventario de Botiquín",cats:["Web","Infraestructura"],
     prob:"Medicinas vencidas y costos difíciles de conciliar en un botiquín.",
     dis:["Motor dual: FEFO decide de qué lote sale la unidad y PEPS valora el costo contable.","Google Sheets como base en tiempo real mediante Apps Script, con auditoría de cada operación.","Imagen multi-etapa con Nginx, manifiestos Kustomize y CI en GitHub Actions."],
     tags:["React","TypeScript","Vite","Apps Script","Google Sheets","Docker","Kubernetes","GitHub Actions"]},
    {id:"MOD-05",icon:"mail-search",name:"Recolector de Facturas",cats:["Escritorio","Automatización"],
     prob:"Horas perdidas bajando facturas PDF, JSON y XML desde la bandeja de correo.",
     dis:["App PySide6 con hilos QThread que lee IMAP solo de remitentes autorizados y evita duplicados por Message-ID.","Licencia atada al hardware (BIOS, disco y MAC con SHA-256), validación cada 24 horas y gracia offline de 72 horas.","Modo headless con --collect para programar la descarga, y dashboard con cuentas por pagar."],
     tags:["Python","PySide6","IMAP","PostgreSQL","Neon","Cryptography"]},
    {id:"MOD-06",icon:"calculator",name:"P&G Contadores",cats:["Web","Automatización"],
     prob:"Los contadores reciben JSON de compras y los pasan a Excel a mano.",
     dis:["Arrastrar y soltar varios JSON y ver la tabla consolidada al instante.","Exportar a Excel con SheetJS, a CSV nativo o imprimir desde el navegador.","Sesión protegida en localStorage. Siguiente paso: JWT con roles."],
     tags:["React 19","Vite","React Router 7","Tailwind CSS","SheetJS"]},
    {id:"MOD-07",icon:"server",name:"API Agente Contable",cats:["Fiscal","Automatización"],
     prob:"Procesar DTE de varios clientes en una misma plataforma sin degradar el rendimiento.",
     dis:["Backend modular y multi-tenant con FastAPI y SQLAlchemy.","Autenticación JWT con contraseñas protegidas por Bcrypt.","PostgreSQL en Neon para producción y SQLite para desarrollo."],
     tags:["FastAPI","Python","SQLAlchemy","PostgreSQL","Neon","JWT","SQLite"]},
    {id:"MOD-08",icon:"truck",name:"Gas Flama",cats:["Móvil"],
     prob:"Pedidos de cilindros de gas mal coordinados y sin ubicación en tiempo real.",
     dis:["App Flutter para móvil y web con arquitectura BLoC y Cubit.","Mapa con OpenStreetMap y geolocalización en segundo plano.","WebSockets para el estado de los pedidos y JWT para las sesiones."],
     tags:["Flutter","BLoC / Cubit","OpenStreetMap","WebSockets","Geolocator","JWT"]},
    {id:"MOD-09",icon:"globe",name:"Sitio web de CreaPx",cats:["Web"],
     prob:"Presentar servicios, soluciones por rubro y portafolio, y convertir visitas en cotizaciones.",
     dis:["SPA con React 19 y Router: inicio, servicios, soluciones, portafolio, tecnología y contacto.","Formulario validado con EmailJS y botón flotante directo a WhatsApp.","Vistas de página con Google Analytics 4 y navbar adaptable a móvil."],
     tags:["React 19","Vite","Tailwind CSS","React Router","Lucide","EmailJS"]},
    {id:"MOD-10",icon:"wrench",name:"Mantenimiento de Computadoras",cats:["Infraestructura"],
     prob:"Equipos lentos, con polvo acumulado y sobrecalentamiento.",
     dis:["Diagnóstico de componentes y limpieza física profunda.","Cambio de pasta térmica y optimización del sistema operativo.","Galería de fotos del antes y el después en el portafolio."],
     tags:["Diagnóstico","Pasta térmica","Optimización de SO","Mantenimiento preventivo"]}
  ];
  var FILTERS=["Todos","Fiscal","Web","Móvil","Escritorio","Automatización","Infraestructura"];
  function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")}
  var grid=document.getElementById("mods");
  grid.innerHTML=MODS.map(function(m){
    return '<article class="mod rv" data-cats="'+esc(m.cats.join("|"))+'">'+
      '<header><span class="mid">'+m.id+'</span><span class="badges">'+m.cats.map(function(c){return '<span class="badge">'+esc(c)+'</span>'}).join("")+'</span></header>'+
      '<div class="mt"><span class="ic"><i data-lucide="'+m.icon+'"></i></span><h3>'+esc(m.name)+'</h3></div>'+
      '<dl><div><dt>Problema</dt><dd>'+esc(m.prob)+'</dd></div>'+
      '<div><dt>Decisiones de diseño</dt><dd><ul>'+m.dis.map(function(d){return '<li><span>'+esc(d)+'</span></li>'}).join("")+'</ul></dd></div></dl>'+
      '<ul class="tags">'+m.tags.map(function(t){return '<li>'+esc(t)+'</li>'}).join("")+'</ul></article>';
  }).join("");

  var fbox=document.getElementById("filters"), count=document.getElementById("count");
  fbox.innerHTML=FILTERS.map(function(f,i){return '<button type="button" class="fchip" data-f="'+f+'" aria-pressed="'+(i===0)+'">'+f+'</button>'}).join("");
  function applyFilter(f,animate){
    var shown=0, cards=grid.querySelectorAll(".mod");
    cards.forEach(function(c){
      var ok=f==="Todos"||c.getAttribute("data-cats").split("|").indexOf(f)>-1;
      c.hidden=!ok; if(ok) shown++;
    });
    count.textContent="Mostrando "+shown+" de "+cards.length+" módulos";
    fbox.querySelectorAll(".fchip").forEach(function(b){b.setAttribute("aria-pressed",String(b.getAttribute("data-f")===f))});
    if(animate && window.anime && !matchMedia("(prefers-reduced-motion: reduce)").matches){
      anime({targets:grid.querySelectorAll(".mod:not([hidden])"),translateY:[14,0],opacity:[.4,1],duration:420,delay:anime.stagger(50),easing:"easeOutCubic"});
    }
  }
  fbox.addEventListener("click",function(e){var b=e.target.closest(".fchip"); if(b) applyFilter(b.getAttribute("data-f"),true)});
  applyFilter("Todos",false);

  /* Tema */
  var root=document.documentElement;
  try{var saved=localStorage.getItem("jr-theme"); if(saved==="dark"||saved==="light") root.setAttribute("data-theme",saved)}catch(e){}
  function eff(){var t=root.getAttribute("data-theme"); if(t) return t; return matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"}
  document.getElementById("themeBtn").addEventListener("click",function(){
    var n=eff()==="dark"?"light":"dark"; root.setAttribute("data-theme",n);
    try{localStorage.setItem("jr-theme",n)}catch(e){}
  });

  /* Copiar */
  function selectText(id){var el=document.getElementById(id); if(!el) return; var r=document.createRange(); r.selectNodeContents(el); var s=getSelection(); s.removeAllRanges(); s.addRange(r)}
  document.querySelectorAll("[data-copy]").forEach(function(b){
    var label=b.querySelector("span"), orig=label.textContent;
    function flash(t){label.textContent=t; setTimeout(function(){label.textContent=orig},1800)}
    b.addEventListener("click",function(){
      var text=b.getAttribute("data-copy"), target=b.getAttribute("data-target");
      if(navigator.clipboard&&navigator.clipboard.writeText){
        navigator.clipboard.writeText(text).then(function(){flash("Copiado")},function(){selectText(target);flash("Seleccionado")});
      }else{selectText(target);flash("Seleccionado")}
    });
  });

  if(window.lucide){try{lucide.createIcons()}catch(e){}}
})();
</script>
<script>
/* Efectos: parallax, anime.js, scrollspy */
(function(){
  var reduce=matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* Scrollspy (siempre activo) */
  var links={}; document.querySelectorAll("#toc a").forEach(function(a){links[a.getAttribute("href").slice(1)]=a});
  if("IntersectionObserver" in window){
    var spy=new IntersectionObserver(function(es){
      es.forEach(function(en){
        if(en.isIntersecting){
          Object.keys(links).forEach(function(k){links[k].classList.toggle("on",k===en.target.id)});
        }
      });
    },{rootMargin:"-25% 0px -65% 0px"});
    document.querySelectorAll(".sec").forEach(function(s){spy.observe(s)});
  }
  if(reduce||!window.anime) return;

  /* Entrada de portada */
  anime({targets:".hero .rise",translateY:[16,0],opacity:[.25,1],duration:800,delay:anime.stagger(90),easing:"easeOutCubic"});
  anime({targets:".stage .chipbox",scale:[.88,1],opacity:[.2,1],duration:700,delay:anime.stagger(120,{start:300}),easing:"easeOutBack"});
  anime({targets:".bigmark",scale:[.9,1],duration:900,easing:"easeOutElastic(1,.7)"});

  /* Anillo del plano girando lento */
  anime({targets:"#ring",rotate:360,duration:70000,easing:"linear",loop:true});

  /* Chips flotando (el wrapper recibe el parallax, el chip interno flota) */
  document.querySelectorAll(".bob").forEach(function(el,i){
    anime({targets:el,translateY:[-4,5],duration:2600+i*450,direction:"alternate",loop:true,easing:"easeInOutSine"});
  });

  /* Líneas de flujo entre capas */
  anime({targets:".flow line",strokeDashoffset:[0,-20],duration:1300,easing:"linear",loop:true});

  /* Contadores */
  document.querySelectorAll("[data-count]").forEach(function(el){
    var n=+el.getAttribute("data-count"), o={v:0};
    anime({targets:o,v:n,round:1,duration:1400,delay:500,easing:"easeOutExpo",update:function(){el.textContent=o.v}});
  });

  /* Parallax: puntero y scroll sobre la ventana de la portada */
  var stage=document.getElementById("stage"), layers=[].slice.call(stage.querySelectorAll("[data-depth]"));
  var mx=0,my=0,pending=false;
  function paint(){
    pending=false;
    var r=stage.getBoundingClientRect(), off=(r.top+r.height/2-innerHeight/2)/innerHeight;
    layers.forEach(function(el){
      var d=parseFloat(el.getAttribute("data-depth"));
      el.style.transform="translate3d("+(mx*d*16).toFixed(1)+"px,"+(my*d*16-off*d*46).toFixed(1)+"px,0)";
    });
  }
  function req(){if(!pending){pending=true;requestAnimationFrame(paint)}}
  stage.addEventListener("pointermove",function(e){
    var r=stage.getBoundingClientRect(); mx=(e.clientX-r.left)/r.width-.5; my=(e.clientY-r.top)/r.height-.5; req();
  });
  stage.addEventListener("pointerleave",function(){mx=0;my=0;req()});
  addEventListener("scroll",req,{passive:true});
  addEventListener("resize",req);
  paint();

  /* Revelado al hacer scroll: solo desplazamiento, el contenido ya es visible */
  if("IntersectionObserver" in window){
    var below=[].slice.call(document.querySelectorAll(".rv")).filter(function(el){return el.getBoundingClientRect().top>innerHeight});
    below.forEach(function(el){el.style.transform="translateY(18px)"});
    var io=new IntersectionObserver(function(es){
      es.forEach(function(en){
        if(en.isIntersecting){
          io.unobserve(en.target);
          anime({targets:en.target,translateY:[18,0],duration:650,easing:"easeOutCubic",complete:function(){en.target.style.transform=""}});
        }
      });
    },{rootMargin:"0px 0px -6% 0px"});
    below.forEach(function(el){io.observe(el)});
  }
})();
</script>

</body></html>